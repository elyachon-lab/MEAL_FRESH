# Ces variables sont OPTIONNELLES : src/lib/supabase/config.ts embarque déjà les
# valeurs du projet Meal Fresh. Ne les renseigner que pour viser un autre projet
# Supabase ou pour prendre en compte une rotation de clé.
#
# Projet Supabase — Settings › API dans le dashboard.
# La clé « publishable » est destinée au navigateur : l'isolation des données
# repose sur les politiques RLS, pas sur le secret de cette clé.

NEXT_PUBLIC_SUPABASE_URL=https://dxaxfxzpttiadfekksrx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx  # Settings → API

# Ancien nom de la clé, toujours accepté par l'application :
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Illustration des recettes (facultatif).
# Clé « Access Key » d'une application créée sur
# https://unsplash.com/oauth/applications — sans elle, le bouton
# « Illustrer les recettes » le signale et les recettes gardent leur vignette
# générée. Volontairement SANS préfixe NEXT_PUBLIC_ : la clé ne doit jamais
# partir dans le bundle du navigateur.
# Attention : une application en mode « Demo » est limitée à 50 requêtes/heure.
UNSPLASH_ACCESS_KEY=
